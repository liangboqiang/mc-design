from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path
from urllib import request


def read_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def url_json(url: str, timeout: float = 5.0) -> dict:
    with request.urlopen(url, timeout=timeout) as resp:
        raw = resp.read().decode("utf-8", errors="replace")
    data = json.loads(raw) if raw else {}
    return data if isinstance(data, dict) else {"ok": True, "data": data}


def run_doctor(root: Path) -> dict:
    client_root = root / "client"
    cmd = [sys.executable, str(client_root / "app" / "mc_design_client.pyz"), "--root", str(client_root), "doctor"]
    raw = subprocess.check_output(cmd, cwd=str(root), stderr=subprocess.STDOUT)
    return json.loads(raw.decode("utf-8", errors="replace"))


def main() -> int:
    parser = argparse.ArgumentParser(description="Verify an installed MC Design client package.")
    parser.add_argument("--root", default=str(Path(__file__).resolve().parent))
    parser.add_argument("--online", action="store_true", help="Require the local Python client API to be running.")
    parser.add_argument("--require-nx", action="store_true", help="Require the NX plugin loopback API to be available.")
    parser.add_argument("--release", action="store_true", help="Require release_eligible=true and bundled Python.")
    args = parser.parse_args()

    root = Path(args.root).resolve()
    failures = []
    warnings = []

    required_files = [
        root / "package-manifest.json",
        root / "McDesignClient.exe",
        root / "start-client.bat",
        root / "client" / "app" / "mc_design_client.pyz",
        root / "client" / "resources" / "agent_assets.mcdpkg",
        root / "client" / "resources" / "mc-design-package.mcdpkg",
        root / "configure" / "mc-design-client.config",
        root / "nx-plugin" / "startup" / "NXServer.dll",
        root / "nx-plugin" / "tools" / "NXTools.dll",
        root / "nx-plugin" / "sdk" / "NXSDK.dll",
    ]
    for path in required_files:
        if not path.exists():
            failures.append("missing required file: " + str(path))

    if (root / "assets" / "source").exists() or (root / "client" / "assets" / "source").exists():
        failures.append("package contains source asset directory")
    for pattern in ("MCPClient.*", "NXWebSocketClient.*"):
        matches = list(root.rglob(pattern))
        if matches:
            failures.append("package contains unsupported artifact " + pattern)

    manifest = {}
    if (root / "package-manifest.json").is_file():
        manifest = read_json(root / "package-manifest.json")
        if args.release:
            if manifest.get("release_eligible") is not True:
                failures.append("manifest release_eligible is not true")
            if manifest.get("python_runtime_bundled") is not True:
                failures.append("manifest python_runtime_bundled is not true")
            if not (root / "client" / "python" / "python.exe").is_file():
                failures.append("bundled client/python/python.exe is missing")

    asset = root / "client" / "resources" / "agent_assets.mcdpkg"
    if asset.is_file():
        text = asset.read_text(encoding="utf-8", errors="ignore")
        for token in ("[[skill.", "SKILL.md", "# Beya"):
            if token in text:
                failures.append("asset package exposes plaintext token: " + token)

    doctor = {}
    try:
        doctor = run_doctor(root)
        assets = (((doctor.get("checks") or {}).get("assets")) or {})
        if assets.get("ok") is not True:
            failures.append("doctor assets check failed")
        local_api = (((doctor.get("checks") or {}).get("local_api")) or {})
        nx_plugin = (((doctor.get("checks") or {}).get("nx_plugin")) or {})
        if args.online and local_api.get("ok") is not True:
            failures.append("local client API is not running or not healthy")
        elif local_api.get("ok") is not True:
            warnings.append("local client API is not running")
        if args.require_nx and nx_plugin.get("ok") is not True:
            failures.append("NX plugin loopback API is unavailable")
        elif nx_plugin.get("ok") is not True:
            warnings.append("NX plugin loopback API is unavailable")
    except Exception as exc:
        failures.append("doctor failed: " + str(exc))

    result = {
        "ok": not failures,
        "root": str(root),
        "release_eligible": manifest.get("release_eligible"),
        "python_runtime_bundled": manifest.get("python_runtime_bundled"),
        "warnings": warnings,
        "failures": failures,
        "doctor": doctor,
    }
    print(json.dumps(result, ensure_ascii=True, indent=2))
    return 0 if not failures else 1


if __name__ == "__main__":
    raise SystemExit(main())
