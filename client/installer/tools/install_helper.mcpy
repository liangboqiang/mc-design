from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import tempfile
import time
from pathlib import Path

try:
    import winreg
except Exception:
    winreg = None


STATE_NAME = "install-state.json"
LEGACY_DESKTOP_SHORTCUTS = ["MC Design Client.bat", "MC Design Smoke Test.bat"]
LEGACY_ENV_NAME = "UGII_CUSTOM_DIRECTORY_FILE"
NX_MARKER_BEGIN = "# MC Design Client BEGIN"
NX_MARKER_END = "# MC Design Client END"
NX_CUSTOM_FILE_NAME = "custom_dirs.dat"
PROTECTED_FILES = set(["configure/mc-design-client.config", "uninstall.bat"])
PROTECTED_DIRS = set(["client/data", "client/logs"])
MANAGED_ROOTS = [
    "client/src",
    "client/app",
    "client/resources",
    "client/python",
    "client/run_client.py",
    "client/pyproject.toml",
    "McDesignClient.exe",
    "nx-plugin",
    "installer",
    "start-client.bat",
    "package-manifest.json",
    "smoke-test.bat",
    "smoke_test.py",
    "install_helper.py",
    "uninstall.bat",
    "README_INSTALL.txt",
]
LEGACY_ROOTS = [
    "code",
    "runtime",
    "startup",
    "tools",
    "sdk",
    "application",
    "plugin",
]
LEGACY_PREFIXES = ("MCPClient.", "NXWebSocketClient.")
CLIENT_PROCESS_NAMES = set(["python.exe", "pythonw.exe", "mcdesignclient.exe"])
NX_PROCESS_NAMES = set(["ugraf.exe"])
CLIENT_PID_FILES = ["client/data/client.pid"]


def rel_key(path):
    return str(path).replace("\\", "/").strip("/")


def normalize_path(value):
    return os.path.normcase(os.path.abspath(os.path.normpath(os.path.expandvars(str(value or "")))))


def is_same_path(left, right):
    if not left or not right:
        return False
    return normalize_path(left) == normalize_path(right)


def safe_child(root, rel):
    root = root.resolve()
    target = (root / rel).resolve()
    root_key = str(root).lower()
    target_key = str(target).lower()
    if target_key != root_key and not target_key.startswith(root_key + os.sep):
        raise RuntimeError("Refusing path outside install dir: %s" % target)
    return target


def is_protected_rel(rel):
    key = rel_key(Path(rel))
    if key in PROTECTED_FILES:
        return True
    for protected_dir in PROTECTED_DIRS:
        if key == protected_dir or key.startswith(protected_dir + "/"):
            return True
    return False


def remove_path(root, rel):
    if is_protected_rel(rel):
        return
    target = safe_child(root, rel)
    if not target.exists():
        return
    if target.is_dir():
        remove_tree_robust(root, target)
        return
    try:
        target.unlink()
    except OSError:
        moved = move_to_delete_pending(root, target)
        if moved is None:
            raise
        try:
            moved.unlink()
        except OSError:
            print("[mc-design] Warning: scheduled locked file for later cleanup: %s" % moved)


def remove_tree_robust(root, target):
    for _attempt in range(5):
        if not target.exists():
            return
        try:
            shutil.rmtree(str(target))
            return
        except OSError:
            time.sleep(0.4)
    moved = move_to_delete_pending(root, target)
    if moved is None:
        raise RuntimeError("Failed to remove locked directory: %s" % target)
    for _attempt in range(3):
        if not moved.exists():
            return
        try:
            shutil.rmtree(str(moved))
            return
        except OSError:
            time.sleep(0.4)
    print("[mc-design] Warning: scheduled locked directory for later cleanup: %s" % moved)


def move_to_delete_pending(root, target):
    root = Path(root).resolve()
    target = Path(target).resolve()
    pending_root = root / ".delete-pending"
    pending_root.mkdir(parents=True, exist_ok=True)
    name = "%s-%s-%s" % (target.name, time.strftime("%Y%m%d%H%M%S"), os.getpid())
    destination = safe_child(root, rel_key(pending_root.relative_to(root) / name))
    for index in range(10):
        candidate = destination if index == 0 else Path(str(destination) + "-%02d" % index)
        try:
            target.rename(candidate)
            print("[mc-design] Moved locked path to pending cleanup: %s" % candidate)
            return candidate
        except OSError:
            time.sleep(0.2)
    return None


def clean_pending_deletes(root):
    pending = Path(root).resolve() / ".delete-pending"
    if not pending.is_dir():
        return
    for child in list(pending.iterdir()):
        try:
            if child.is_dir():
                remove_tree_robust(root, child)
            else:
                child.unlink()
        except OSError:
            pass
    try:
        pending.rmdir()
    except OSError:
        pass


def read_text(path):
    try:
        return path.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return ""


def write_text(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8", newline="") as handle:
        handle.write(text)


def read_nx_custom_text(path):
    if not path.is_file():
        return ""
    for encoding in ("utf-8-sig", "mbcs", "utf-8"):
        try:
            return path.read_text(encoding=encoding)
        except LookupError:
            continue
        except UnicodeDecodeError:
            continue
    return path.read_text(encoding="utf-8", errors="ignore")


def write_nx_custom_text(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    encoding = "mbcs"
    try:
        with path.open("w", encoding=encoding, newline="") as handle:
            handle.write(text)
    except LookupError:
        with path.open("w", encoding="utf-8", newline="") as handle:
            handle.write(text)


def delete_registry_value(root_key, subkey, name):
    if winreg is None:
        return False
    key = None
    try:
        key = winreg.OpenKey(root_key, subkey, 0, winreg.KEY_SET_VALUE)
        winreg.DeleteValue(key, name)
        return True
    except FileNotFoundError:
        return False
    except OSError as exc:
        print("[mc-design] Warning: failed to delete registry value %s: %s" % (name, exc))
        return False
    finally:
        if key is not None:
            try:
                winreg.CloseKey(key)
            except OSError:
                pass


def remove_legacy_ugii_custom_directory_file_env():
    os.environ.pop(LEGACY_ENV_NAME, None)
    removed = False
    if winreg is not None:
        removed = delete_registry_value(winreg.HKEY_CURRENT_USER, "Environment", LEGACY_ENV_NAME) or removed
    if removed:
        print("[mc-design] Removed legacy environment variable %s." % LEGACY_ENV_NAME)
    return removed


def remove_state_owned(root):
    state_file = root / STATE_NAME
    if not state_file.is_file():
        return
    try:
        state = json.loads(state_file.read_text(encoding="utf-8"))
    except Exception:
        return
    for rel in state.get("owned_files", []):
        remove_path(root, str(rel))
    dirs = sorted([str(item) for item in state.get("owned_dirs", [])], key=len, reverse=True)
    for rel in dirs:
        if is_protected_rel(rel):
            continue
        target = safe_child(root, rel)
        try:
            target.rmdir()
        except OSError:
            pass
    try:
        state_file.unlink()
    except OSError:
        pass


def clean_known_residue(root):
    for rel in MANAGED_ROOTS + LEGACY_ROOTS:
        remove_path(root, rel)
    clean_config_residue(root)
    if not root.exists():
        return
    for path in list(root.rglob("*")):
        if not path.is_file():
            continue
        if any(path.name.startswith(prefix) for prefix in LEGACY_PREFIXES):
            try:
                remove_path(root, rel_key(path.relative_to(root)))
            except ValueError:
                pass


def clean_config_residue(root):
    configure = root / "configure"
    if not configure.is_dir():
        return
    for path in list(configure.iterdir()):
        try:
            rel = rel_key(path.relative_to(root))
        except ValueError:
            continue
        if not is_protected_rel(rel):
            remove_path(root, rel)


def query_processes():
    errors = []
    try:
        data = subprocess.check_output(
            ["wmic", "process", "get", "ProcessId,Name,ExecutablePath,CommandLine", "/FORMAT:LIST"],
            stderr=subprocess.STDOUT,
        )
        try:
            raw = data.decode("mbcs", errors="ignore")
        except LookupError:
            raw = data.decode("utf-8", errors="ignore")
        entries = parse_process_list(raw)
        if entries:
            return entries
    except Exception as exc:
        errors.append("wmic: %s" % exc)

    try:
        powershell = Path(os.environ.get("SystemRoot", r"C:\Windows")) / "System32" / "WindowsPowerShell" / "v1.0" / "powershell.exe"
        command = (
            "$ErrorActionPreference='SilentlyContinue';"
            "if (Get-Command Get-CimInstance -ErrorAction SilentlyContinue) {"
            "$rows = @(Get-CimInstance Win32_Process -ErrorAction SilentlyContinue)"
            "} else {"
            "$rows = @(Get-WmiObject Win32_Process -ErrorAction SilentlyContinue)"
            "};"
            "foreach ($p in $rows) {"
            "'CommandLine=' + [string]$p.CommandLine;"
            "'ExecutablePath=' + [string]$p.ExecutablePath;"
            "'Name=' + [string]$p.Name;"
            "'ProcessId=' + [string]$p.ProcessId;"
            "''"
            "}"
        )
        data = subprocess.check_output(
            [str(powershell), "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", command],
            stderr=subprocess.STDOUT,
        )
        for encoding in ("mbcs", "utf-8", "utf-16"):
            try:
                raw = data.decode(encoding, errors="ignore")
                entries = parse_process_list(raw)
                if entries:
                    return entries
            except LookupError:
                continue
    except Exception as exc:
        errors.append("powershell: %s" % exc)

    print("[mc-design] Warning: failed to query processes: %s" % "; ".join(errors))
    return []


def parse_process_list(raw):

    entries = []
    current = {}
    for line in str(raw or "").splitlines():
        line = line.strip()
        if not line:
            if current:
                entries.append(current)
                current = {}
            continue
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        current[key.strip()] = value.strip()
    if current:
        entries.append(current)
    return entries


def process_mentions_root(entry, root):
    root_text = str(root).lower()
    root_norm = normalize_path(root)
    command = str(entry.get("CommandLine") or "")
    executable = str(entry.get("ExecutablePath") or "")
    if root_text and root_text in command.lower():
        return True
    if root_text and root_text in executable.lower():
        return True
    if executable:
        try:
            exe_norm = normalize_path(executable)
            if exe_norm == root_norm or exe_norm.startswith(root_norm + os.sep):
                return True
        except Exception:
            pass
    return False


def read_pid_file(root, rel):
    path = Path(root).resolve() / rel
    try:
        text = path.read_text(encoding="ascii", errors="ignore").strip()
        pid = int(text)
        return pid if pid > 0 else 0
    except Exception:
        return 0


def add_pid_file_processes(root, existing):
    known = set()
    for _entry, pid, _name in existing:
        known.add(pid)
    for rel in CLIENT_PID_FILES:
        pid = read_pid_file(root, rel)
        if pid and pid not in known and pid != os.getpid():
            existing.append(({"ProcessId": str(pid), "Name": "client-pid-file", "ExecutablePath": "", "CommandLine": ""}, pid, "client-pid-file"))
            known.add(pid)
    return existing


def delete_client_pid_files(root):
    for rel in CLIENT_PID_FILES:
        path = Path(root).resolve() / rel
        try:
            path.unlink()
        except OSError:
            pass


def kill_process(pid, name):
    try:
        proc = subprocess.run(
            ["taskkill", "/PID", str(pid), "/T", "/F"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        output = decode_process_output(proc.stdout or b"").strip()
        if proc.returncode == 0:
            print("[mc-design] Stopped process %s pid=%s." % (name, pid))
            return True
        if "not found" in output.lower() or "not running" in output.lower():
            print("[mc-design] Process already stopped %s pid=%s." % (name, pid))
            return True
        print("[mc-design] Warning: failed to stop %s pid=%s: %s" % (name, pid, output))
    except Exception as exc:
        print("[mc-design] Warning: failed to stop %s pid=%s: %s" % (name, pid, exc))
    return False


def decode_process_output(raw):
    for encoding in ("mbcs", "utf-8", "gbk"):
        try:
            return raw.decode(encoding, errors="ignore")
        except LookupError:
            continue
    return raw.decode("utf-8", errors="ignore")


def confirm_stop_nx_processes(processes):
    if not processes:
        return True
    print("[mc-design] NX is running. It must be stopped before plugin files are changed.")
    for entry in processes:
        print("[mc-design] NX process pid=%s path=%s" % (
            str(entry.get("ProcessId") or ""),
            str(entry.get("ExecutablePath") or ""),
        ))
    try:
        answer = input("[mc-design] Stop NX? Enter Y to stop, N to cancel: ").strip().lower()
    except EOFError:
        answer = ""
    if answer in ("y", "yes"):
        return True
    print("[mc-design] Cancelled. Close NX and retry.")
    return False


def stop_running_processes(root, include_nx=True):
    root = Path(root).resolve()
    current_pid = os.getpid()
    client_processes = []
    nx_processes = []
    stopped = []
    for entry in query_processes():
        try:
            pid = int(str(entry.get("ProcessId") or "0"))
        except ValueError:
            continue
        if pid <= 0 or pid == current_pid:
            continue
        name = str(entry.get("Name") or "").lower()
        if name in CLIENT_PROCESS_NAMES and process_mentions_root(entry, root):
            client_processes.append((entry, pid, name))
            continue
        if include_nx and name in NX_PROCESS_NAMES:
            nx_processes.append((entry, pid, name))

    add_pid_file_processes(root, client_processes)

    if nx_processes and not confirm_stop_nx_processes([item[0] for item in nx_processes]):
        raise RuntimeError("NX is running and user declined to stop it.")

    failures = []
    for _entry, pid, name in client_processes:
        if kill_process(pid, name):
            stopped.append({"pid": pid, "name": name, "reason": "client"})
        elif name == "client-pid-file":
            print("[mc-design] Ignored stale client pid file pid=%s." % pid)
        else:
            failures.append("%s pid=%s" % (name, pid))
    for _entry, pid, name in nx_processes:
        if kill_process(pid, name):
            stopped.append({"pid": pid, "name": name, "reason": "nx-plugin"})
        else:
            failures.append("%s pid=%s" % (name, pid))
    if failures:
        raise RuntimeError("Failed to stop required processes: " + ", ".join(failures))
    if stopped:
        wait_for_stopped_processes(root, include_nx=include_nx)
    else:
        print("[mc-design] No running MC Design or NX processes found.")
    return stopped


def wait_for_stopped_processes(root, include_nx=True):
    deadline = time.time() + 8.0
    current_pid = os.getpid()
    while time.time() < deadline:
        remaining = []
        for entry in query_processes():
            try:
                pid = int(str(entry.get("ProcessId") or "0"))
            except ValueError:
                pid = 0
            if pid == current_pid:
                continue
            name = str(entry.get("Name") or "").lower()
            if name in CLIENT_PROCESS_NAMES and process_mentions_root(entry, root):
                remaining.append(name)
                continue
            if include_nx and name in NX_PROCESS_NAMES:
                remaining.append(name)
        if not remaining:
            return
        time.sleep(0.5)
    print("[mc-design] Warning: some processes may still be exiting.")


def preinstall(args):
    root = Path(args.install_dir).resolve()
    root.mkdir(parents=True, exist_ok=True)
    try:
        stop_running_processes(root, include_nx=True)
    except RuntimeError as exc:
        print("[mc-design] Preinstall cleanup failed: %s" % exc)
        return 7
    delete_client_pid_files(root)
    clean_pending_deletes(root)
    remove_state_owned(root)
    clean_known_residue(root)
    clean_pending_deletes(root)
    print("[mc-design] Cleaned previous managed files.")
    return 0


def unquote_config(value):
    text = str(value or "").strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in ("'", '"'):
        return text[1:-1]
    return text


def read_config_values(path):
    values = {}
    section = ""
    if not path.is_file():
        return values
    for raw in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip()
            continue
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = unquote_config(value)
        if section:
            values[section + "." + key] = value
        else:
            values[key] = value
    return values


def quote_config(value):
    text = str(value or "")
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def render_minimal_config(values):
    def pick(key, default=""):
        return values.get(key, default)

    lines = [
        "# User-editable mc-design client configuration.",
        "# Only machine/user runtime values belong here.",
        "",
        "[client]",
        "user_id = " + quote_config(pick("client.user_id", "local")),
        "user_name = " + quote_config(pick("client.user_name", "")),
        "",
        "[runtime]",
        "port = " + str(pick("runtime.port", "8765") or "8765"),
        "",
        "[ai_service]",
        "tc_key = " + quote_config(pick("ai_service.tc_key", "")),
        "",
        "[nx_plugin]",
        "port = " + str(pick("nx_plugin.port", "8088") or "8088"),
        "",
    ]
    return "\r\n".join(lines)


def ensure_config(source, root):
    config = root / "configure" / "mc-design-client.config"
    source_config = Path(source).resolve() / "configure" / "mc-design-client.config"
    if not source_config.is_file():
        raise RuntimeError("missing packaged config: %s" % source_config)
    values = read_config_values(source_config)
    values.update(read_config_values(config))
    write_text(config, render_minimal_config(values))

def resolve_nx_custom_dir_file(nx_base_dir):
    raw = str(nx_base_dir or "").strip().strip('"')
    if not raw:
        raise RuntimeError("UGII_BASE_DIR was not found. Provide the NX11 install directory.")
    base = Path(os.path.expandvars(raw)).resolve()
    candidates = []
    if base.name.upper() == "UGII":
        candidates.append(base)
        candidates.append(base.parent / "UGII")
    else:
        candidates.append(base / "UGII")
        candidates.append(base)
    seen = set()
    for ugii_dir in candidates:
        key = normalize_path(ugii_dir)
        if key in seen:
            continue
        seen.add(key)
        menus_dir = ugii_dir / "menus"
        if menus_dir.is_dir():
            return ugii_dir, menus_dir, menus_dir / NX_CUSTOM_FILE_NAME
    expected = [str(item / "menus" / NX_CUSTOM_FILE_NAME) for item in candidates]
    raise RuntimeError("NX11 UGII menus directory was not found. Tried: " + "; ".join(expected))


def strip_mc_design_block(lines):
    result = []
    in_block = False
    for line in lines:
        stripped = line.strip()
        if stripped == NX_MARKER_BEGIN:
            in_block = True
            continue
        if stripped == NX_MARKER_END:
            in_block = False
            continue
        if not in_block:
            result.append(line.rstrip("\r\n"))
    while result and not result[-1].strip():
        result.pop()
    return result


def register_nx_custom_dir(root, nx_base_dir):
    plugin_dir = root / "nx-plugin"
    ugii_dir, menus_dir, custom_file = resolve_nx_custom_dir_file(nx_base_dir)
    existing = read_nx_custom_text(custom_file).splitlines() if custom_file.is_file() else []
    lines = strip_mc_design_block(existing)
    if lines:
        lines.append("")
    lines.extend([NX_MARKER_BEGIN, str(plugin_dir), NX_MARKER_END])
    write_nx_custom_text(custom_file, "\r\n".join(lines) + "\r\n")
    print("[mc-design] Registered NX plugin path: %s" % custom_file)
    return {
        "nx_base_dir": str(Path(nx_base_dir).resolve()),
        "ugii_dir": str(ugii_dir),
        "menus_dir": str(menus_dir),
        "custom_dir_file": str(custom_file),
        "plugin_dir": str(plugin_dir),
        "marker_begin": NX_MARKER_BEGIN,
        "marker_end": NX_MARKER_END,
    }


def unregister_nx_custom_dir(state):
    nx = state.get("nx_custom_dir", {}) if isinstance(state, dict) else {}
    custom_file = Path(str(nx.get("custom_dir_file") or ""))
    if not custom_file.is_file():
        return
    lines = strip_mc_design_block(read_nx_custom_text(custom_file).splitlines())
    write_nx_custom_text(custom_file, ("\r\n".join(lines) + "\r\n") if lines else "")
    print("[mc-design] Removed NX plugin path: %s" % custom_file)


def desktop_dir():
    home = os.environ.get("USERPROFILE", "")
    if not home:
        return None
    path = Path(home) / "Desktop"
    return path if path.exists() else None


def create_shortcuts(root):
    cleanup_desktop_shortcuts()
    return []


def cleanup_desktop_shortcuts():
    desktop = desktop_dir()
    if desktop is None:
        return []
    removed = []
    for name in LEGACY_DESKTOP_SHORTCUTS:
        path = desktop / name
        try:
            path.unlink()
            removed.append(str(path))
        except OSError:
            pass
    if removed:
        print("[mc-design] Removed legacy desktop launchers.")
    return removed


def collect_state(root, nx_custom_dir, shortcuts):
    files = []
    dirs = []
    for path in root.rglob("*"):
        try:
            rel = rel_key(path.relative_to(root))
        except ValueError:
            continue
        if is_protected_rel(rel):
            continue
        if path.is_file():
            files.append(rel)
        elif path.is_dir():
            dirs.append(rel)
    return {
        "format": 1,
        "installed_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "install_dir": str(root),
        "owned_files": sorted(files),
        "owned_dirs": sorted(dirs, key=len, reverse=True),
        "protected_paths": sorted(list(PROTECTED_FILES | PROTECTED_DIRS)),
        "nx_custom_dir": nx_custom_dir,
        "desktop_shortcuts": shortcuts,
    }


def postinstall(args):
    root = Path(args.install_dir).resolve()
    ensure_config(args.source, root)
    remove_legacy_ugii_custom_directory_file_env()
    nx_custom_dir = register_nx_custom_dir(root, args.nx_base_dir)
    shortcuts = create_shortcuts(root)
    state = collect_state(root, nx_custom_dir, shortcuts)
    write_text(root / STATE_NAME, json.dumps(state, ensure_ascii=True, indent=2))
    print("[mc-design] Wrote install-state.json.")
    return 0


def uninstall(args):
    root = Path(args.install_dir).resolve()
    try:
        stop_running_processes(root, include_nx=True)
    except RuntimeError as exc:
        print("[mc-design] Uninstall failed: %s" % exc)
        return 7
    delete_client_pid_files(root)
    state_path = root / STATE_NAME
    state = {}
    if state_path.is_file():
        try:
            state = json.loads(state_path.read_text(encoding="utf-8"))
        except Exception:
            state = {}
    unregister_nx_custom_dir(state)

    shortcuts = list(state.get("desktop_shortcuts", [])) if isinstance(state, dict) else []
    desktop = desktop_dir()
    if desktop is not None:
        shortcuts.extend([str(desktop / name) for name in LEGACY_DESKTOP_SHORTCUTS])
    for item in set(shortcuts):
        try:
            Path(item).unlink()
        except OSError:
            pass
    clean_pending_deletes(root)
    remove_state_owned(root)
    clean_known_residue(root)
    clean_pending_deletes(root)
    print("[mc-design] Removed NX registration, managed files, and shortcuts.")
    return 0


def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command")

    pre = sub.add_parser("preinstall")
    pre.add_argument("--install-dir", required=True)

    check = sub.add_parser("check-nx")
    check.add_argument("--nx-base-dir", required=True)

    post = sub.add_parser("postinstall")
    post.add_argument("--source", required=True)
    post.add_argument("--install-dir", required=True)
    post.add_argument("--nx-base-dir", required=True)

    un = sub.add_parser("uninstall")
    un.add_argument("--install-dir", required=True)

    args = parser.parse_args()
    if args.command == "preinstall":
        return preinstall(args)
    if args.command == "check-nx":
        try:
            _ugii_dir, _menus_dir, custom_file = resolve_nx_custom_dir_file(args.nx_base_dir)
        except Exception as exc:
            print("[mc-design] NX11 directory is not usable: %s" % exc)
            return 6
        print("[mc-design] NX config file: %s" % custom_file)
        return 0
    if args.command == "postinstall":
        return postinstall(args)
    if args.command == "uninstall":
        return uninstall(args)
    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
